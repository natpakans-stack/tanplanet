{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.tanplanet.work"
        }
      ],
      "destination": "https://myfolio.tanplanet.work/$1",
      "permanent": true
    },
    {
      "source": "/portfolio",
      "destination": "https://projects.tanplanet.work/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(woff2|woff|ttf|otf|css|avif|webp|png|svg)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}