{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "hangun.tanplanet.info"
        }
      ],
      "destination": "https://tanplanet.work/hangun/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "projects.tanplanet.info"
        }
      ],
      "destination": "https://projects.tanplanet.work/$1",
      "permanent": true
    },
    {
      "source": "/carpark",
      "destination": "https://tanplanet.work/carpark",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "destination": "https://tanplanet.work/",
      "permanent": true
    }
  ]
}
