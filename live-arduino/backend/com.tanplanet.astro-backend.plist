<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tanplanet.astro-backend</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>backend/server.mjs</string>
  </array>

  <!-- server.mjs อ่าน data/ กับ backend/tools/ ด้วย path สัมพัทธ์ -->
  <key>WorkingDirectory</key>
  <string>/Users/natpakansirirat/Documents/Projects/tanplanet/live-arduino</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/tmp/tanplanet-backend.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/tanplanet-backend.err</string>
</dict>
</plist>
