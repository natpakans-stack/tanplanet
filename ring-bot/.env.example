# ก๊อปเป็น .env แล้วเติมค่าจริง — ไฟล์นี้ห้ามใส่ค่าจริง (repo public)
CHANNEL_ACCESS_TOKEN=      # LINE Developers > Messaging API > Channel access token
WEBAPP_URL=                # npx @google/clasp list-deployments แล้วเอา /exec ของตัวล่าสุด
SHEET_URL=                 # ได้จาก Log ตอนรัน ringSetup
DEPLOY_ID=                 # id ของ deployment ที่ใช้อยู่ (ไว้ deploy ทับตัวเดิม)
